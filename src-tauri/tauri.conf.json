{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SunnyDrop",
  "version": "0.4.0",
  "identifier": "dev.clarence.sunnydrop.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SunnyDrop",
        "width": 1280,
        "height": 840,
        "minWidth": 1050,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "radial",
        "title": "SunnyDrop",
        "url": "index.html?mode=radial",
        "width": 300,
        "height": 300,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "dragDropEnabled": true,
        "shadow": false
      },
      {
        "label": "popup",
        "title": "SunnyDrop",
        "url": "index.html?mode=popup",
        "width": 460,
        "height": 560,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "dragDropEnabled": false,
        "shadow": false,
        "minWidth": 320,
        "minHeight": 220
      },
      {
        "label": "welcome",
        "title": "Welcome to SunnyDrop",
        "url": "index.html?mode=welcome",
        "width": 680,
        "height": 500,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost 'self'; font-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Your private, local AI PDF workspace",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "licenses/"
    ]
  }
}
